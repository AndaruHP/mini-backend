      "seed": 1363384189,
      "version": 513,
      "versionNonce": 1384406077,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794417470198,
      "link": null,
      "locked": false,
      "text": "i tried to not turn the payment-service on, then all data on order.created topics on payment-service not\nproceed yet. Also in order db i set the status into CREATED then if order-service already consume invoice.created\nit will change into INVOICED. So i do understand that data that not distributed yet will remain in kafka. if\nrelated service turn on already they will consume it and use the data either for save it on db or publish into topics.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i tried to not turn the payment-service on, then all data on order.created topics on payment-service not\nproceed yet. Also in order db i set the status into CREATED then if order-service already consume invoice.created\nit will change into INVOICED. So i do understand that data that not distributed yet will remain in kafka. if\nrelated service turn on already they will consume it and use the data either for save it on db or publish into topics.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
